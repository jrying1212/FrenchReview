generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ImportStatus {
  empty
  extracting
  ready
  failed
}

enum ParseStatus {
  not_started
  processing
  ready
  failed
}

enum StructuredContentSource {
  fake
  manual
  live
}

model Lesson {
  id              String       @id @default(uuid())
  title           String
  lessonDate      DateTime?
  pdfStorageKey   String?
  pdfOriginalName String?
  rawText         String?
  parsedContent   Json?
  importStatus    ImportStatus @default(empty)
  parseStatus     ParseStatus  @default(not_started)
  parseErrorCode  String?
  structuredContentSource StructuredContentSource?
  structuredSchemaVersion Int?
  structuredPromptVersion String?
  structuredModelId       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  quizzes         Quiz[]

  @@index([createdAt, id])
}

model Quiz {
  id                  String   @id @default(uuid())
  lessonId            String
  sourceSchemaVersion Int
  questions           Json
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  lesson              Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, isActive])
  @@index([lessonId, createdAt, id])
}
