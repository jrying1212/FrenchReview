generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ImportStatus {
  empty
  extracting
  ready
  failed
}

enum ParseStatus {
  not_started
  processing
  ready
  failed
}

enum StructuredContentSource {
  fake
  manual
  live
}

enum MasteryStatus {
  known
  learning
  weak
}

enum ReviewItemType {
  vocabulary
  sentence
}

model Lesson {
  id              String       @id @default(uuid())
  title           String
  lessonDate      DateTime?
  pdfStorageKey   String?
  pdfOriginalName String?
  rawText         String?
  parsedContent   Json?
  importStatus    ImportStatus @default(empty)
  parseStatus     ParseStatus  @default(not_started)
  parseErrorCode  String?
  structuredContentSource StructuredContentSource?
  structuredSchemaVersion Int?
  structuredPromptVersion String?
  structuredModelId       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  quizzes         Quiz[]
  quizAttempts    QuizAttempt[]
  reviewItems     ReviewItem[]

  @@index([createdAt, id])
}

model ReviewItem {
  id               String         @id @default(uuid())
  lessonId         String
  structuredItemId String
  itemType         ReviewItemType
  position         Int
  status           MasteryStatus  @default(learning)
  lastReviewedAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, structuredItemId])
  @@unique([lessonId, itemType, position])
  @@index([status, lastReviewedAt, createdAt, id])
  @@index([lessonId, itemType])
}

model Quiz {
  id                  String   @id @default(uuid())
  lessonId            String
  sourceSchemaVersion Int
  questions           Json
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  lesson              Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts            QuizAttempt[]

  @@index([lessonId, isActive])
  @@index([lessonId, createdAt, id])
}

model QuizAttempt {
  id            String   @id
  lessonId      String
  quizId        String
  requestHash   String
  answers       Json
  results       Json
  correctCount  Int
  questionCount Int
  scorePercent  Int
  createdAt     DateTime @default(now())
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt, id])
  @@index([quizId])
}
